{
    "name": "spatie/ssl-certificate-chain-resolver",
    "description": "SSL certificate chain resolver",
    "keywords": [
        "ssl-certificate-chain-resolver",
        "ssl",
        "certificate",
        "chain",
        "https"
    ],
    "homepage": "https://github.com/spatie/ssl-certificate-chain-resolver",
    "license": "MIT",
    "authors": [
        {
            "name": "Freek Van der Herten",
            "email": "freek@spatie.be"
        }
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.4",
        "illuminate/collections": "^12.0|^13.0",
        "phpseclib/phpseclib": "^3.0",
        "symfony/console": "^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^5.0",
        "phpstan/phpstan": "^2.3.6"
    },
    "autoload": {
        "psr-4": {
            "Spatie\\CertificateChain\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spatie\\CertificateChain\\Test\\": "tests"
        }
    },
    "bin": [
        "ssl-certificate-chain-resolver"
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest",
        "format": "pint",
        "analyse": "phpstan analyse",
        "test:lint": "pint --test",
        "check": [
            "@test:lint",
            "@analyse",
            "@test"
        ]
    },
    "minimum-stability": "stable"
}
